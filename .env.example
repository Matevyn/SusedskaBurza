# Služba pre lokálny vývoj – pripojenie na Azure SQL
#
# Nacítanie zo súboru .env (ako kľúč:hodnota)
# Heslo SA NESHRAVAT do tohto projektu, nie ani do gitu.
# Nahraď túto hodnotu svojím heslom pri game pre tento projekt.
#
# 1) Skopíruj tentuť súbor ako .env
#    cp .env.example .env
# 2) Doplň heslom
# 3) Spusti backend:  DB_USER=... DB_PASSWORD=... uvicorn backednd.main:app --reload

# Užívateľ v Azure SQL
DB_USER=Matus-admin

# 🔑 Hörav tvoje heslo pre thisu SQL Server (môže byť aj asi sa heslom)
DB_PASSWORD=vyplňte_svoje_heslo

# Názov servera (logical server) v Azure
DB_SERVER=skolsky-projekt.database.windows.net

# Názov databázy
DB_NAME=SusedskaBurza

# ODBC driver pre SQL Server (súladowo s ODBC Driver 18 for SQL Server)
# (ak je nainštalovaný, inak použi ODBC Driver 17)
DB_DRIVER=ODBC+Driver+18+for+SQL+Server
