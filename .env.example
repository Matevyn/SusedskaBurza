# Služba pre lokálny vývoj – pripojenie na Azure SQL
#
# Nacítanie zo súboru .env (ako kľúč:hodnota)
# Heslo SA NESHRAVAT do tohto projektu, nie ani do gitu.
# Nahraď túto hodnotu svojím heslom pri spustení tohto projektu.
#
# 1) Skopíruj tento súbor ako .env
#       cp .env.example .env
# 2) Do .env doplň heslo
# 3) Spusti backend:
#       DB_USER=... DB_PASSWORD=... uvicorn backend.main:app --reload

# Užívateľ v Azure SQL
DB_USER=Matus-admin

# 🔑 Hodnota tvojho hesla pre Azure SQL Server
DB_PASSWORD=vyplňte_svoje_heslo

# Názov servera (logical server) v Azure
DB_SERVER=skolsky-projekt.database.windows.net

# Názov databázy
DB_NAME=SusedskaBurza

# Driver – predvolené: pymssql ( SQLAlchemy + pymssql )
# Zmenť na pyodbc ak používaš ODBC Driver
DB_DRIVER=pymssql
